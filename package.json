{
  "name": "anima",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mobile": "jest --runInBand",
    "build:mobile": "expo export --platform all --output-dir dist-mobile",
    "check": "npm run typecheck && npm test && npm run test:mobile && npm run build:mobile",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^0.544.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.22",
    "expo-document-picker": "~57.0.3",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "decode-uri-component": "^0.5.0"
  }
